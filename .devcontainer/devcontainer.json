{
  "name": "TDisplayS3_Adventure - OpenCode Dev",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "LordImmaculate.platformio-ide",
        "llvm-vs-code-extensions.vscode-clangd"
      ]
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": true
    }
  },
  "remoteUser": "opencode",
  "initializeCommand": "echo 'Initializing Dev Container'",
  "postCreateCommand": "bash .devcontainer/setup-env.sh && pio pkg install -e t_display_s3"
}
